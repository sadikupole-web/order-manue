# Supabase 环境变量配置说明（请复制此文件为 .env.local 并填入真实值）
# 注意：严禁在前端配置 SUPABASE_SERVICE_ROLE_KEY！

# Supabase 项目 API URL (在 Supabase 控制台 -> Settings -> API 中查看)
VITE_SUPABASE_URL=https://your-project-id.supabase.co

# Supabase 客户端公开匿名 Key (anon public key)
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# 情侣专属小屋标识（默认为 our_home，保证两台手机加入同一个情侣空间）
VITE_COUPLE_SPACE_ID=our_home
